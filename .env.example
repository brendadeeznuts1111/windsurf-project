# ULTRA-ARB GLOBAL - Production Environment Variables
# Copy this file to .env and configure your production values

# ===========================================
# SECURITY CONFIGURATION (REQUIRED)
# ===========================================

# JWT Secret Key - Must be 32+ characters for HMAC-SHA256 security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-32-character-or-longer-secret-key-here

# Session Configuration
SESSION_COOKIE_NAME=ultra-arb-session
SESSION_MAX_AGE=86400000  # 24 hours in milliseconds

# ===========================================
# TELEGRAM INTEGRATION (OPTIONAL)
# ===========================================

# Telegram Bot Token - Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Chat ID for notifications (your personal chat or group)
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# SQLite Database Path (relative to project root)
DATABASE_PATH=./data/ultra-arb.db

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server Port
PORT=6969

# Environment (development, staging, production)
NODE_ENV=production

# HTTPS Configuration (REQUIRED for production HttpOnly cookies)
# Set to true in production environments
FORCE_HTTPS=true

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Enable detailed logging (set to false in production for performance)
ENABLE_DEBUG_LOGGING=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===========================================
# PERFORMANCE TUNING
# ===========================================

# Maximum concurrent connections
MAX_CONNECTIONS=1247

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Rate limiting window in milliseconds
RATE_LIMIT_WINDOW=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# TEAM ORGANIZATION CONFIG
# ===========================================

# Default team configuration file
TEAM_CONFIG_FILE=config/team-hierarchy.toml

# Enable team synchronization with GitHub
ENABLE_GITHUB_SYNC=false

# GitHub Personal Access Token (for team sync)
GITHUB_TOKEN=your-github-token-here

# ===========================================
# AZURE DEVOPS INTEGRATION (OPTIONAL)
# ===========================================

# Azure DevOps Organization URL
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org

# Azure DevOps Project Name
AZURE_DEVOPS_PROJECT=your-project

# Azure DevOps Personal Access Token
AZURE_DEVOPS_TOKEN=your-azure-token-here

# ===========================================
# MONITORING & METRICS
# ===========================================

# Enable Prometheus metrics
ENABLE_PROMETHEUS=true

# Metrics port (separate from main server)
METRICS_PORT=9090

# ===========================================
# BACKUP & RECOVERY
# ===========================================

# Enable automatic backups
ENABLE_BACKUPS=true

# Backup interval in hours
BACKUP_INTERVAL_HOURS=24

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ===========================================
# SECURITY HEADERS
# ===========================================

# Content Security Policy
CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# HSTS Max Age (1 year)
HSTS_MAX_AGE=31536000

# ===========================================
# CACHE CONFIGURATION
# ===========================================

# Enable response caching
ENABLE_CACHE=true

# Cache TTL in seconds
CACHE_TTL=300

# Maximum cache size in MB
MAX_CACHE_SIZE=100