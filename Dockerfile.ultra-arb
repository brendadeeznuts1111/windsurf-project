# ULTRA-ARB GLOBAL - Production Dockerfile
# Zero-dependency Bun 1.3 enterprise deployment

FROM oven/bun:1.3-alpine AS base

# Install security updates and required packages
RUN apk add --no-cache \
    openssl \
    curl \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S bunuser -u 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json bun.lock bunfig.toml ./

# Install dependencies (production only)
RUN bun install --frozen-lockfile --production

# ===========================================
# Build Stage
# ===========================================
FROM base AS builder

# Copy source code
COPY . .

# Build the application (if needed)
RUN bun run build 2>/dev/null || echo "No build step required"

# Create data directory for SQLite
RUN mkdir -p /app/data && \
    chown -R bunuser:nodejs /app/data

# ===========================================
# Production Stage
# ===========================================
FROM base AS production

# Copy built application
COPY --from=builder --chown=bunuser:nodejs /app /app

# Create data directory with proper permissions
RUN mkdir -p /app/data && \
    chown -R bunuser:nodejs /app/data

# Switch to non-root user
USER bunuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:6969/health || exit 1

# Expose port
EXPOSE 6969

# Environment variables
ENV NODE_ENV=production
ENV FORCE_HTTPS=true
ENV DATABASE_PATH=/app/data/ultra-arb.db
ENV PORT=6969

# Start the application
CMD ["bun", "run", "src/auth/login-handlers.ts"]