# Development Environment Configuration
NODE_ENV=development
VITE_APP_TITLE="Bun Fetch API Interactive Demo"
VITE_API_BASE_URL=https://dev.api.example.com
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGGING=true
VITE_PERFORMANCE_MONITORING=true

# Server Configuration
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_OPEN=false

# Test Configuration
VITE_TEST_TIMEOUT=10000
VITE_TEST_CONCURRENT=true
VITE_TEST_COVERAGE=true

# Feature Flags
VITE_ENABLE_PID_DEMO=true
VITE_ENABLE_TELEMETRY_DEMO=true
VITE_ENABLE_FILE_IO_DEMO=true
VITE_ENABLE_CUSTOM_API=true