# Production Environment Configuration
NODE_ENV=production
VITE_APP_TITLE="Bun Fetch API Interactive Demo"
VITE_API_BASE_URL=https://api.example.com
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_LOGGING=false
VITE_PERFORMANCE_MONITORING=true

# Build Configuration
VITE_PRODUCTION_BUILD=true
VITE_SOURCEMAPS=false
VITE_MINIFY=true

# Feature Flags
VITE_ENABLE_PID_DEMO=true
VITE_ENABLE_TELEMETRY_DEMO=true
VITE_ENABLE_FILE_IO_DEMO=true
VITE_ENABLE_CUSTOM_API=true

# Analytics
VITE_GA_TRACKING_ID=GA_MEASUREMENT_ID
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id