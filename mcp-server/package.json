{
  "name": "bun-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Bun documentation and Azure DevOps integration",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "original": "bun run bun-mcp-server.ts",
    "azure": "bun run ../scripts/az-devops-cli.ts",
    "az:status": "bun run ../scripts/az-devops-cli.ts status",
    "az:sync": "bun run ../scripts/az-devops-cli.ts sync"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
